<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.portfolio.defstuf.controllers.MainViewController"
      styleClass="dark-background">
   
   <!-- Top bar with user info and logout -->
   <top>
      <HBox alignment="CENTER_RIGHT" spacing="15" styleClass="top-bar">
         <children>
            <Label fx:id="userLabel" text="Welcome, User" styleClass="neu-label-light" style="-fx-font-size: 16px;" />
            <Button fx:id="logoutButton" text="Logout" onAction="#handleLogout" 
                    styleClass="neu-button-secondary" />
         </children>
      </HBox>
   </top>
   
   <!-- Main content -->
   <center>
      <VBox alignment="CENTER" spacing="30" style="-fx-padding: 40;">
         <children>
            <Label text="Welcome to DefStuf" styleClass="section-title" />
            <Label fx:id="infoLabel" text="System Information" styleClass="neu-label" />
            <VBox spacing="15" alignment="CENTER">
               <Button fx:id="createNoteButton" text="Create Note" onAction="#openCreateNoteView" 
                       styleClass="neu-button-primary" prefWidth="250" />
               <Button fx:id="startReviewButton" text="Start Review" onAction="#openStudySessionConfigView" 
                       styleClass="neu-button-primary" prefWidth="250" />
               <Button fx:id="manageAreasButton" text="Manage Areas" onAction="#openManageAreasView" 
                       styleClass="neu-button-primary" prefWidth="250" />
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>

