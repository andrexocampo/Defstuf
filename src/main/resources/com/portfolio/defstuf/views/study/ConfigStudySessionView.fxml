<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.portfolio.defstuf.controllers.study.ConfigStudySessionController"
            styleClass="dark-background">
   
   <top>
      <VBox spacing="15" styleClass="top-bar">
         <HBox spacing="20" alignment="CENTER_LEFT">
            <Button text="← Back" onAction="#handleBack" styleClass="neu-button-back" />
            <Label text="Configure Study Session" styleClass="section-title" />
         </HBox>
      </VBox>
   </top>
   
   <center>
      <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="scroll-pane">
         <VBox spacing="30" style="-fx-padding: 40;" styleClass="dark-background">
            
            <!-- Area Selection Section -->
            <VBox spacing="20" styleClass="neumorphic-panel">
               <Label text="Select Area to Review" styleClass="subsection-title" />
               <Separator />
               <VBox spacing="15">
                  <Label fx:id="areasStatusLabel" text="" styleClass="status-label" />
                  <ScrollPane fitToWidth="true" minHeight="200" prefHeight="300" maxHeight="400" styleClass="scroll-pane">
                     <VBox fx:id="areasContainer" spacing="12" style="-fx-padding: 15;" />
                  </ScrollPane>
               </VBox>
            </VBox>
            
            <!-- Source Selection Section (appears when area is selected) -->
            <VBox fx:id="sourcesContainer" spacing="20" styleClass="neumorphic-panel" visible="false" managed="false">
               <Label text="Select Sources (Optional)" styleClass="subsection-title" />
               <Separator />
               <VBox spacing="15">
                  <HBox spacing="15" alignment="CENTER_LEFT">
                     <CheckBox fx:id="selectAllSourcesCheckbox" text="Select All Sources" 
                              onAction="#handleSelectAllSources" />
                     <Label fx:id="selectedSourcesCountLabel" text="" styleClass="status-label" />
                  </HBox>
                  <ScrollPane fitToWidth="true" minHeight="150" prefHeight="200" maxHeight="300" styleClass="scroll-pane">
                     <VBox fx:id="sourcesCheckboxContainer" spacing="10" style="-fx-padding: 15;" />
                  </ScrollPane>
                  <Label fx:id="sourcesStatusLabel" 
                        text="Select one or more sources to filter notes. Leave empty to include all sources." 
                        styleClass="status-label" />
               </VBox>
            </VBox>
            
            <!-- Session Configuration Section -->
            <VBox spacing="20" styleClass="neumorphic-panel">
               <Label text="Session Configuration" styleClass="subsection-title" />
               <Separator />
               
               <GridPane hgap="25" vgap="20">
                  <columnConstraints>
                     <ColumnConstraints minWidth="200" prefWidth="250" />
                     <ColumnConstraints minWidth="200" prefWidth="300" />
                  </columnConstraints>
                  
                  <!-- Time Limit -->
                  <Label text="Time Limit (minutes):" GridPane.columnIndex="0" GridPane.rowIndex="0" 
                         styleClass="neu-label-light" />
                  <ComboBox fx:id="timeLimitCombo" GridPane.columnIndex="1" GridPane.rowIndex="0" 
                            prefWidth="250" />
                  
                  <!-- Cards Limit -->
                  <Label text="Cards/Definitions Limit:" GridPane.columnIndex="0" GridPane.rowIndex="1" 
                         styleClass="neu-label-light" />
                  <ComboBox fx:id="cardsLimitCombo" GridPane.columnIndex="1" GridPane.rowIndex="1" 
                            prefWidth="250" />
                  
                  <!-- Review Order -->
                  <Label text="Review Order:" GridPane.columnIndex="0" GridPane.rowIndex="2" 
                         styleClass="neu-label-light" />
                  <ComboBox fx:id="reviewOrderCombo" GridPane.columnIndex="1" GridPane.rowIndex="2" 
                            prefWidth="250" />
               </GridPane>
            </VBox>
            
         </VBox>
      </ScrollPane>
   </center>
   
   <bottom>
      <VBox spacing="15" styleClass="bottom-bar">
         <HBox alignment="CENTER" spacing="20">
            <Button fx:id="startSessionButton" text="Start Study Session" 
                    onAction="#handleStartSession"
                    styleClass="neu-button-primary" />
            <Button text="Cancel" onAction="#handleBack"
                    styleClass="neu-button-secondary" />
         </HBox>
         <HBox alignment="CENTER">
            <Label fx:id="statusLabel" text="" styleClass="status-label" />
         </HBox>
      </VBox>
   </bottom>
</BorderPane>



