<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.portfolio.defstuf.controllers.study.ConfigStudySessionController"
            style="-fx-background-color: #f5f5f5;">
   
   <top>
      <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20;">
         <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="← Back" onAction="#handleBack" 
                    style="-fx-background-color: #666; -fx-text-fill: white; -fx-padding: 8 16;" />
            <Label text="Configure Study Session" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
         </HBox>
         <Separator />
      </VBox>
   </top>
   
   <center>
      <ScrollPane fitToWidth="true" fitToHeight="true">
         <VBox spacing="25" style="-fx-padding: 30; -fx-background-color: #f5f5f5;">
            
            <!-- Area Selection Section -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8;">
               <Label text="Select Area to Review" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
               <Separator />
               <ScrollPane fitToWidth="true" maxHeight="300" style="-fx-background-color: #fafafa;">
                  <VBox fx:id="areasContainer" spacing="10" style="-fx-padding: 10;" />
               </ScrollPane>
               <Label fx:id="areasStatusLabel" text="" style="-fx-text-fill: #666; -fx-font-size: 12px;" />
            </VBox>
            
            <!-- Session Configuration Section -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8;">
               <Label text="Session Configuration" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
               <Separator />
               
               <GridPane hgap="20" vgap="15">
                  <columnConstraints>
                     <ColumnConstraints minWidth="200" prefWidth="250" />
                     <ColumnConstraints minWidth="200" prefWidth="300" />
                  </columnConstraints>
                  
                  <!-- Time Limit -->
                  <Label text="Time Limit (minutes):" GridPane.columnIndex="0" GridPane.rowIndex="0" 
                         style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                  <ComboBox fx:id="timeLimitCombo" GridPane.columnIndex="1" GridPane.rowIndex="0" 
                            prefWidth="200" />
                  
                  <!-- Cards Limit -->
                  <Label text="Cards/Definitions Limit:" GridPane.columnIndex="0" GridPane.rowIndex="1" 
                         style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                  <ComboBox fx:id="cardsLimitCombo" GridPane.columnIndex="1" GridPane.rowIndex="1" 
                            prefWidth="200" />
                  
                  <!-- Review Order -->
                  <Label text="Review Order:" GridPane.columnIndex="0" GridPane.rowIndex="2" 
                         style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                  <ComboBox fx:id="reviewOrderCombo" GridPane.columnIndex="1" GridPane.rowIndex="2" 
                            prefWidth="200" />
               </GridPane>
            </VBox>
            
         </VBox>
      </ScrollPane>
   </center>
   
   <bottom>
      <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20;">
         <HBox alignment="CENTER" spacing="15">
            <Button fx:id="startSessionButton" text="Start Study Session" 
                    onAction="#handleStartSession"
                    style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-padding: 12 40; -fx-font-size: 16px; -fx-font-weight: bold;" />
            <Button text="Cancel" onAction="#handleBack"
                    style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-padding: 12 30; -fx-font-size: 14px;" />
         </HBox>
         <HBox alignment="CENTER" style="-fx-padding: 5 0 0 0;">
            <Label fx:id="statusLabel" text="" style="-fx-text-fill: #666;" />
         </HBox>
      </VBox>
   </bottom>
</BorderPane>

