<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.portfolio.defstuf.controllers.area.AreaDetailController"
            styleClass="dark-background">
   
   <top>
      <VBox spacing="15" styleClass="top-bar">
         <HBox spacing="20" alignment="CENTER_LEFT">
            <Button text="← Back" onAction="#handleBack" styleClass="neu-button-back" />
            <Label fx:id="titleLabel" text="Area Detail" styleClass="section-title" />
         </HBox>
         <Separator />
      </VBox>
   </top>
   
   <center>
      <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="scroll-pane">
         <VBox spacing="25" style="-fx-padding: 40; -fx-max-width: 700;">
            
            <!-- Basic Information Section -->
            <VBox spacing="15" styleClass="neumorphic-panel">
               <Label text="Basic Information" styleClass="subsection-title" />
               <Separator />
               
               <VBox spacing="12">
                  <HBox spacing="15">
                     <Label text="Name:" styleClass="neu-label-light" style="-fx-min-width: 120;" />
                     <Label fx:id="nameLabel" text="" styleClass="neu-label-light" />
                  </HBox>
                  
                  <HBox spacing="15">
                     <Label text="Code:" styleClass="neu-label-light" style="-fx-min-width: 120;" />
                     <Label fx:id="codeLabel" text="" styleClass="neu-label-light" />
                  </HBox>
                  
                  <HBox spacing="15">
                     <Label text="Created:" styleClass="neu-label-light" style="-fx-min-width: 120;" />
                     <Label fx:id="createdLabel" text="" styleClass="neu-label-light" />
                  </HBox>
               </VBox>
            </VBox>
            
            <!-- Statistics Section (Prepared for future) -->
            <VBox spacing="15" styleClass="neumorphic-panel">
               <Label text="Statistics" styleClass="subsection-title" />
               <Separator />
               <Label fx:id="statisticsLabel" text="No statistics available yet." 
                      styleClass="status-label" />
            </VBox>
            
            <!-- Notes Section (Prepared for future) -->
            <VBox spacing="15" styleClass="neumorphic-panel">
               <Label text="Notes in this Area" styleClass="subsection-title" />
               <Separator />
               <Label fx:id="notesLabel" text="No notes available yet." 
                      styleClass="status-label" />
            </VBox>
            
         </VBox>
      </ScrollPane>
   </center>
   
   <bottom>
      <HBox spacing="15" alignment="CENTER_RIGHT" styleClass="bottom-bar">
         <Button fx:id="deleteButton" text="Delete Area" onAction="#handleDelete" 
                 styleClass="neu-button-secondary" style="-fx-background-color: #d32f2f; -fx-text-fill: white;" />
         <Button fx:id="editButton" text="Edit Area" onAction="#handleEdit" 
                 styleClass="neu-button-primary" />
      </HBox>
   </bottom>
</BorderPane>

