<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.portfolio.defstuf.controllers.area.EditAreaController"
            styleClass="dark-background">
   
   <top>
      <VBox spacing="15" styleClass="top-bar">
         <Label text="Edit Area" styleClass="section-title" />
         <Separator />
      </VBox>
   </top>
   
   <center>
      <VBox spacing="25" alignment="CENTER" style="-fx-padding: 40; -fx-max-width: 500;">
         <VBox spacing="10" styleClass="neumorphic-panel">
            <VBox spacing="8">
               <Label text="Name:" styleClass="neu-label-light" />
               <TextField fx:id="nameField" promptText="Enter area name" />
               <Label fx:id="nameErrorLabel" text="" styleClass="status-label-error" />
            </VBox>
            
            <VBox spacing="8">
               <Label text="Code:" styleClass="neu-label-light" />
               <TextField fx:id="codeField" promptText="Enter area code" />
               <Label text="Code can only contain letters, numbers, and underscores (max 50 characters)" 
                      styleClass="status-label" />
               <Label fx:id="codeErrorLabel" text="" styleClass="status-label-error" />
            </VBox>
         </VBox>
      </VBox>
   </center>
   
   <bottom>
      <HBox spacing="15" alignment="CENTER_RIGHT" styleClass="bottom-bar">
         <Button fx:id="cancelButton" text="Cancel" onAction="#handleCancel" 
                 styleClass="neu-button-secondary" />
         <Button fx:id="saveButton" text="Save Changes" onAction="#handleSave" 
                 styleClass="neu-button-primary" />
      </HBox>
   </bottom>
</BorderPane>

