<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.portfolio.defstuf.controllers.area.ManageAreasController"
            styleClass="dark-background">
   
   <top>
      <VBox spacing="15" styleClass="top-bar">
         <HBox spacing="20" alignment="CENTER_LEFT">
            <Button text="← Back" onAction="#handleBack" styleClass="neu-button-back" />
            <Label text="Manage Areas" styleClass="section-title" />
         </HBox>
         <Separator />
         <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button fx:id="createNewAreaButton" text="Create New Area" onAction="#handleCreateNewArea" 
                    styleClass="neu-button-primary" />
         </HBox>
      </VBox>
   </top>
   
   <center>
      <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="scroll-pane">
         <FlowPane fx:id="areasFlowPane" 
                   hgap="20" vgap="20" 
                   alignment="TOP_LEFT"
                   style="-fx-padding: 30;" styleClass="dark-background" />
      </ScrollPane>
   </center>
   
   <bottom>
      <HBox alignment="CENTER" styleClass="bottom-bar">
         <Label fx:id="statusLabel" text="" styleClass="status-label" />
      </HBox>
   </bottom>
</BorderPane>

