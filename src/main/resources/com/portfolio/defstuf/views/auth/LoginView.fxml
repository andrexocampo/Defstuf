<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.portfolio.defstuf.controllers.auth.LoginController"
            styleClass="dark-background">
   
   <center>
      <VBox alignment="CENTER" spacing="25" styleClass="neumorphic-panel" maxWidth="450">
         
         <Label text="Welcome to DefStuf" styleClass="section-title" />
         
         <Label text="Sign in to continue" styleClass="neu-label" />
         
         <Separator />
         
         <VBox spacing="20" style="-fx-padding: 20 0;">
            <!-- Email Field -->
            <VBox spacing="8">
               <Label text="Email:" styleClass="neu-label-light" />
               <TextField fx:id="emailField" promptText="Enter your email" />
            </VBox>
            
            <!-- Password Field -->
            <VBox spacing="8">
               <Label text="Password:" styleClass="neu-label-light" />
               <PasswordField fx:id="passwordField" 
                              promptText="Enter your password"
                              onAction="#handleLogin" />
            </VBox>
            
            <!-- Login Button -->
            <Button fx:id="loginButton" 
                    text="Login" 
                    onAction="#handleLogin"
                    defaultButton="true"
                    styleClass="neu-button-primary"
                    prefWidth="250" />
            
            <!-- Register Link -->
            <HBox alignment="CENTER" spacing="5" style="-fx-padding: 10 0;">
               <Label text="Don't have an account?" styleClass="status-label" />
               <Hyperlink fx:id="registerLink" 
                          text="Register here" 
                          onAction="#navigateToRegister" />
            </HBox>
         </VBox>
      </VBox>
   </center>
   
</BorderPane>








