<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.portfolio.defstuf.controllers.auth.RegisterController"
            styleClass="dark-background">
   
   <center>
      <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="scroll-pane">
         <VBox alignment="CENTER" spacing="25" styleClass="neumorphic-panel" maxWidth="450">
            
            <Label text="Create Account" styleClass="section-title" />
            
            <Label text="Register to get started" styleClass="neu-label" />
            
            <Separator />
            
            <VBox spacing="20" style="-fx-padding: 20 0;">
               <!-- Name Field -->
               <VBox spacing="8">
                  <Label text="Name:" styleClass="neu-label-light" />
                  <TextField fx:id="nameField" promptText="Enter your name" />
               </VBox>
               
               <!-- Email Field -->
               <VBox spacing="8">
                  <Label text="Email:" styleClass="neu-label-light" />
                  <TextField fx:id="emailField" promptText="Enter your email" />
               </VBox>
               
               <!-- Password Field -->
               <VBox spacing="8">
                  <Label text="Password:" styleClass="neu-label-light" />
                  <PasswordField fx:id="passwordField" 
                                 promptText="Enter password (min 6 characters)" />
               </VBox>
               
               <!-- Confirm Password Field -->
               <VBox spacing="8">
                  <Label text="Confirm Password:" styleClass="neu-label-light" />
                  <PasswordField fx:id="confirmPasswordField" 
                                 promptText="Confirm your password"
                                 onAction="#handleRegister" />
               </VBox>
               
               <!-- Register Button -->
               <Button fx:id="registerButton" 
                       text="Register" 
                       onAction="#handleRegister"
                       defaultButton="true"
                       styleClass="neu-button-primary"
                       prefWidth="250" />
               
               <!-- Login Link -->
               <HBox alignment="CENTER" spacing="5" style="-fx-padding: 10 0;">
                  <Label text="Already have an account?" styleClass="status-label" />
                  <Hyperlink fx:id="loginLink" 
                             text="Login here" 
                             onAction="#navigateToLogin" />
               </HBox>
            </VBox>
         </VBox>
      </ScrollPane>
   </center>
   
</BorderPane>








