<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.portfolio.defstuf.controllers.note.ViewSourcesController"
            style="-fx-background-color: #f5f5f5;">
   
   <top>
      <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15;">
         <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Your Sources" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
         </HBox>
         <Separator />
      </VBox>
   </top>
   
   <center>
      <ScrollPane fitToWidth="true" fitToHeight="true">
         <VBox fx:id="sourcesContainer" 
               spacing="10" 
               style="-fx-padding: 15; -fx-background-color: #f5f5f5;" />
      </ScrollPane>
   </center>
   
   <bottom>
      <VBox spacing="10" style="-fx-padding: 10; -fx-background-color: white;">
         <HBox alignment="CENTER" spacing="10">
            <Label fx:id="statusLabel" text="" style="-fx-text-fill: #666;" />
         </HBox>
         <HBox alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
            <Button fx:id="addSourceButton" text="Add Source" onAction="#handleAddSource" 
                    style="-fx-background-color: #0078d4; -fx-text-fill: white; -fx-padding: 10 20; -fx-font-size: 14px;" />
         </HBox>
      </VBox>
   </bottom>
</BorderPane>

