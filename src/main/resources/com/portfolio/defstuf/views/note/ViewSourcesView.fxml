<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.portfolio.defstuf.controllers.note.ViewSourcesController"
            styleClass="dark-background">
   
   <top>
      <VBox spacing="15" styleClass="top-bar">
         <Label text="Your Sources" styleClass="section-title" />
         <Separator />
      </VBox>
   </top>
   
   <center>
      <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="scroll-pane">
         <VBox fx:id="sourcesContainer" 
               spacing="15" 
               style="-fx-padding: 30;" styleClass="dark-background" />
      </ScrollPane>
   </center>
   
   <bottom>
      <VBox spacing="15" styleClass="bottom-bar">
         <HBox alignment="CENTER">
            <Label fx:id="statusLabel" text="" styleClass="status-label" />
         </HBox>
         <HBox alignment="CENTER_RIGHT">
            <Button fx:id="addSourceButton" text="Add Source" onAction="#handleAddSource" 
                    styleClass="neu-button-primary" />
         </HBox>
      </VBox>
   </bottom>
</BorderPane>

