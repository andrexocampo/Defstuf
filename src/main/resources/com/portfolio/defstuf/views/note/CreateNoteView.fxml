<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.portfolio.defstuf.controllers.note.CreateNoteController"
            style="-fx-background-color: #f5f5f5;">
   
   <top>
      <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20;">
         <Label text="Create Note" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
         <Separator />
      </VBox>
   </top>
   
   <center>
      <ScrollPane fitToWidth="true" fitToHeight="true">
         <VBox spacing="20" style="-fx-padding: 20;">
            
            <!-- Title Section -->
            <VBox spacing="5">
               <Label text="Title:" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
               <TextField fx:id="titleField" promptText="Enter note title..." 
                          style="-fx-font-size: 14px;" />
            </VBox>
            
            <!-- Source Section -->
            <VBox spacing="5">
               <Label text="Source:" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
               <HBox spacing="10">
                  <ComboBox fx:id="sourceComboBox" promptText="Select source..." 
                            style="-fx-font-size: 14px;" HBox.hgrow="ALWAYS" />
                  <Button fx:id="addSourceButton" text="Add Source" 
                          onAction="#handleAddSource"
                          style="-fx-font-size: 14px; -fx-padding: 5 10; -fx-background-color: #007bff; -fx-text-fill: white;" />
                  <Button fx:id="viewSourcesButton" text="View Sources" 
                          onAction="#handleViewSources"
                          style="-fx-font-size: 14px; -fx-padding: 5 10; -fx-background-color: #6c757d; -fx-text-fill: white;" />
               </HBox>
            </VBox>
            
            <!-- Area, Source and Note Type Section -->
            <HBox spacing="20">
               <VBox spacing="5" HBox.hgrow="ALWAYS">
                  <Label text="Area:" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                  <ComboBox fx:id="areaComboBox" promptText="Select area..." 
                            style="-fx-font-size: 14px;" />
               </VBox>
               
               <VBox spacing="5" HBox.hgrow="ALWAYS">
                  <Label text="Note Type:" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                  <ComboBox fx:id="noteTypeComboBox" promptText="Select note type..." 
                            style="-fx-font-size: 14px;" />
               </VBox>
            </HBox>
            
            <!-- Description Section -->
            <VBox spacing="5">
               <Label text="Description:" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
               <TextArea fx:id="descriptionArea" promptText="Enter note description (optional)..." 
                         wrapText="true" prefRowCount="5"
                         style="-fx-font-size: 14px;" />
            </VBox>
            
            <!-- Screenshots Section -->
            <VBox spacing="10">
               <HBox spacing="10" alignment="CENTER_LEFT">
                  <Label text="Screenshots:" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                  <Button fx:id="captureButton" 
                          text="Capture Screenshot" 
                          onAction="#captureScreenshot"
                          style="-fx-font-size: 14px; -fx-padding: 8 16; -fx-background-color: #0078d4; -fx-text-fill: white;" />
               </HBox>
               
               <!-- Screenshots Container -->
               <BorderPane style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-width: 1;">
                  <center>
                     <ScrollPane fitToWidth="true" minHeight="300" maxHeight="400">
                        <VBox fx:id="screenshotsContainer" spacing="10" style="-fx-padding: 10;">
                           <Label fx:id="screenshotsPlaceholderLabel" 
                                  text="No screenshots captured yet" 
                                  style="-fx-text-fill: #999999; -fx-alignment: CENTER;" />
                        </VBox>
                     </ScrollPane>
                  </center>
               </BorderPane>
            </VBox>
            
         </VBox>
      </ScrollPane>
   </center>
   
   <bottom>
      <HBox spacing="10" alignment="CENTER_RIGHT" 
            style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
         <Button fx:id="cancelButton" 
                 text="Cancel" 
                 onAction="#cancel"
                 style="-fx-font-size: 14px; -fx-padding: 8 16; -fx-background-color: #6c757d; -fx-text-fill: white;" />
         
         <Button fx:id="saveButton" 
                 text="Save Note" 
                 onAction="#saveNote"
                 style="-fx-font-size: 14px; -fx-padding: 8 16; -fx-background-color: #28a745; -fx-text-fill: white;" />
      </HBox>
   </bottom>
   
</BorderPane>



