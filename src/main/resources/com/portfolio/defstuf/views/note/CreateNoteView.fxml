<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.portfolio.defstuf.controllers.note.CreateNoteController"
            styleClass="dark-background">
   
   <top>
      <VBox spacing="15" styleClass="top-bar">
         <Label text="Create Note" styleClass="section-title" />
         <Separator />
      </VBox>
   </top>
   
   <center>
      <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="scroll-pane">
         <VBox spacing="25" style="-fx-padding: 30;" styleClass="dark-background">
            <VBox spacing="20" styleClass="neumorphic-panel">
            
               <!-- Title Section -->
               <VBox spacing="8">
                  <Label text="Title:" styleClass="neu-label-light" />
                  <TextField fx:id="titleField" promptText="Enter note title..." />
               </VBox>
               
               <!-- Source Section -->
               <VBox spacing="8">
                  <Label text="Source:" styleClass="neu-label-light" />
                  <HBox spacing="10">
                     <ComboBox fx:id="sourceComboBox" promptText="Select source..." HBox.hgrow="ALWAYS" />
                     <Button fx:id="addSourceButton" text="Add Source" 
                             onAction="#handleAddSource"
                             styleClass="neu-button-secondary" />
                     <Button fx:id="viewSourcesButton" text="View Sources" 
                             onAction="#handleViewSources"
                             styleClass="neu-button-secondary" />
                  </HBox>
               </VBox>
               
               <!-- Area, Source and Note Type Section -->
               <HBox spacing="20">
                  <VBox spacing="8" HBox.hgrow="ALWAYS">
                     <Label text="Area:" styleClass="neu-label-light" />
                     <ComboBox fx:id="areaComboBox" promptText="Select area..." />
                  </VBox>
                  
                  <VBox spacing="8" HBox.hgrow="ALWAYS">
                     <Label text="Note Type:" styleClass="neu-label-light" />
                     <ComboBox fx:id="noteTypeComboBox" promptText="Select note type..." />
                  </VBox>
               </HBox>
               
               <!-- Description Section -->
               <VBox spacing="8">
                  <Label text="Description:" styleClass="neu-label-light" />
                  <TextArea fx:id="descriptionArea" promptText="Enter note description (optional)..." 
                            wrapText="true" prefRowCount="5" />
               </VBox>
               
               <!-- Screenshots Section -->
               <VBox spacing="10">
                  <HBox spacing="10" alignment="CENTER_LEFT">
                     <Label text="Screenshots:" styleClass="neu-label-light" />
                     <Button fx:id="captureButton" 
                             text="Capture Screenshot" 
                             onAction="#captureScreenshot"
                             styleClass="neu-button-secondary" />
                  </HBox>
                  
                  <!-- Screenshots Container -->
                  <BorderPane styleClass="neumorphic-inset">
                     <center>
                        <ScrollPane fitToWidth="true" minHeight="300" maxHeight="400" styleClass="scroll-pane">
                           <VBox fx:id="screenshotsContainer" spacing="10" style="-fx-padding: 15;">
                              <Label fx:id="screenshotsPlaceholderLabel" 
                                     text="No screenshots captured yet" 
                                     styleClass="status-label" 
                                     style="-fx-alignment: CENTER;" />
                           </VBox>
                        </ScrollPane>
                     </center>
                  </BorderPane>
               </VBox>
            </VBox>
         </VBox>
      </ScrollPane>
   </center>
   
   <bottom>
      <HBox spacing="15" alignment="CENTER_RIGHT" styleClass="bottom-bar">
         <Button fx:id="cancelButton" 
                 text="Cancel" 
                 onAction="#cancel"
                 styleClass="neu-button-secondary" />
         
         <Button fx:id="saveButton" 
                 text="Save Note" 
                 onAction="#saveNote"
                 styleClass="neu-button-primary" />
      </HBox>
   </bottom>
   
</BorderPane>



